# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun. .env git'e eklenmez.

# --- Veritabanı ---
DB_NAME=survey
DB_USERNAME=survey
DB_PASSWORD=change-me
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/survey

# --- JWT ---
# HS256 imza anahtarı; en az 32 karakter olmalı. Üretmek için: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-characters

# --- CORS ---
# Virgülle ayrılmış izinli origin listesi
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Ön yüz ---
# Davet linklerinin tabanı (link = FRONTEND_BASE_URL/s/{token})
FRONTEND_BASE_URL=http://localhost:3000
